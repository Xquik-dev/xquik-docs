{
  "name": "xquik-bash",
  "displayName": "bash",
  "scopeName": "source.xquik.bash",
  "aliases": ["bash", "sh", "shell", "shellscript", "zsh"],
  "patterns": [
    {
      "name": "comment.line",
      "match": "(?:^|(?<=\\s))#.*$"
    },
    {
      "name": "string.quoted.double",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single",
      "begin": "'",
      "end": "'"
    },
    {
      "name": "keyword.control",
      "match": "\\b(?:if|then|else|elif|fi|for|in|do|done|while|until|case|esac|function|return|export|local)\\b"
    },
    {
      "name": "entity.name.function",
      "match": "\\b(?:curl|jq|npm|npx|pnpm|yarn|bun|pip|pip3|python|python3|node|go|gem|composer|dotnet|mvn|gradle|git|brew|docker|openssl|echo|mkdir|cd|cat)\\b"
    }
  ],
  "repository": {}
}
