{
  "name": "xquik-kotlin",
  "displayName": "kotlin",
  "scopeName": "source.xquik.kotlin",
  "aliases": ["kotlin", "kt", "kts"],
  "patterns": [
    {
      "name": "comment.line",
      "match": "//.*$"
    },
    {
      "name": "comment.block",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.triple",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "patterns": [
        {
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted",
      "begin": "'",
      "end": "'|$",
      "patterns": [
        {
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.control",
      "match": "\\b(?:fun|val|var|class|object|interface|data|sealed|enum|package|import|return|if|else|when|for|while|do|try|catch|finally|throw|is|in|as|by|override|private|public|internal|protected|companion|suspend|null|true|false|this|super)\\b"
    }
  ],
  "repository": {}
}
