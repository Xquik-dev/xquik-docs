{
  "name": "xquik-go",
  "displayName": "go",
  "scopeName": "source.xquik.go",
  "aliases": ["go", "golang"],
  "patterns": [
    {
      "name": "comment.line",
      "match": "//.*$"
    },
    {
      "name": "comment.block",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.raw",
      "begin": "`",
      "end": "`"
    },
    {
      "name": "string.quoted",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted",
      "begin": "'",
      "end": "'|$",
      "patterns": [
        {
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.control",
      "match": "\\b(?:break|case|chan|const|continue|default|defer|else|fallthrough|for|func|go|goto|if|import|interface|map|package|range|return|select|struct|switch|type|var|nil|true|false)\\b"
    }
  ],
  "repository": {}
}
