{
  "name": "xquik-typescript",
  "displayName": "typescript",
  "scopeName": "source.xquik.typescript",
  "aliases": ["typescript", "ts", "mts", "cts", "tsx"],
  "patterns": [
    {
      "name": "comment.line",
      "match": "//.*$"
    },
    {
      "name": "comment.block",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.template",
      "begin": "`",
      "end": "`",
      "patterns": [
        {
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted",
      "begin": "'",
      "end": "'|$",
      "patterns": [
        {
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.control",
      "match": "\\b(?:const|let|var|function|return|if|else|for|while|do|switch|case|default|break|continue|new|await|async|try|catch|finally|throw|class|extends|import|from|export|typeof|instanceof|in|of|null|undefined|true|false|this|yield|void|delete|interface|type|enum|implements|public|private|protected|readonly|as|keyof)\\b"
    }
  ],
  "repository": {}
}
