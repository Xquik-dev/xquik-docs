{
  "name": "xquik-javascript",
  "displayName": "javascript",
  "scopeName": "source.xquik.javascript",
  "aliases": ["javascript", "js", "mjs", "cjs"],
  "patterns": [
    {
      "name": "comment.line",
      "match": "//.*$"
    },
    {
      "name": "comment.block",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.template",
      "begin": "`",
      "end": "`",
      "patterns": [
        {
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted",
      "begin": "'",
      "end": "'|$",
      "patterns": [
        {
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.control",
      "match": "\\b(?:const|let|var|function|return|if|else|for|while|do|switch|case|default|break|continue|new|await|async|try|catch|finally|throw|class|extends|import|from|export|typeof|instanceof|in|of|null|undefined|true|false|this|yield|void|delete)\\b"
    }
  ],
  "repository": {}
}
