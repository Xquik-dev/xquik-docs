{
  "name": "xquik-csharp",
  "displayName": "csharp",
  "scopeName": "source.xquik.csharp",
  "aliases": ["csharp", "cs", "c#"],
  "patterns": [
    {
      "name": "comment.line",
      "match": "//.*$"
    },
    {
      "name": "comment.block",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.triple",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "patterns": [
        {
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted",
      "begin": "'",
      "end": "'|$",
      "patterns": [
        {
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.control",
      "match": "\\b(?:using|namespace|class|struct|interface|enum|record|public|private|protected|internal|static|readonly|const|sealed|abstract|override|virtual|new|return|if|else|for|foreach|while|do|switch|case|default|break|continue|try|catch|finally|throw|var|void|async|await|is|as|in|out|ref|params|string|int|long|bool|double|decimal|object|null|true|false|this|base)\\b"
    }
  ],
  "repository": {}
}
