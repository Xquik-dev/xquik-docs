{
  "name": "xquik-python",
  "displayName": "python",
  "scopeName": "source.xquik.python",
  "aliases": ["python", "py"],
  "patterns": [
    {
      "name": "comment.line",
      "match": "(?:^|(?<=\\s))#.*$"
    },
    {
      "name": "string.quoted.triple",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "patterns": [
        {
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.triple",
      "begin": "'''",
      "end": "'''",
      "patterns": [
        {
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted",
      "begin": "'",
      "end": "'|$",
      "patterns": [
        {
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.control",
      "match": "\\b(?:def|class|return|if|elif|else|for|while|try|except|finally|raise|import|from|as|with|lambda|yield|pass|break|continue|async|await|None|True|False|and|or|not|in|is|global|nonlocal|del|assert)\\b"
    }
  ],
  "repository": {}
}
