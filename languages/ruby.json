{
  "name": "xquik-ruby",
  "displayName": "ruby",
  "scopeName": "source.xquik.ruby",
  "aliases": ["ruby", "rb"],
  "patterns": [
    {
      "name": "comment.line",
      "match": "(?:^|(?<=\\s))#.*$"
    },
    {
      "name": "string.quoted",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted",
      "begin": "'",
      "end": "'|$",
      "patterns": [
        {
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.control",
      "match": "\\b(?:def|end|class|module|return|if|elsif|else|unless|while|until|for|do|begin|rescue|ensure|raise|require|require_relative|yield|then|case|when|and|or|not|in|nil|true|false|self)\\b"
    }
  ],
  "repository": {}
}
