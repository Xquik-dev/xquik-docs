{
  "name": "xquik-docs",
  "private": true,
  "scripts": {
    "format": "bun run --bun --no-install oxfmt --write",
    "format:check": "bun run --bun --no-install oxfmt --check .",
    "lint": "bun run --bun --no-install oxlint --type-aware --type-check --deny-warnings --report-unused-disable-directives-severity=error .",
    "lint:shell": "shellcheck --check-sourced --severity=style --extended-analysis=true scripts/licenses.sh",
    "audit": "osv-scanner scan source --config=osv-scanner.toml --licenses=0BSD,Apache-2.0,BlueOak-1.0.0,BSD-2-Clause,BSD-3-Clause,CC-BY-4.0,CC0-1.0,Elastic-2.0,ISC,LGPL-3.0-or-later,MIT,MPL-2.0,Python-2.0,Unlicense -L package-lock.json",
    "gitleaks": "gitleaks git --config=.gitleaks.toml --redact=100 --no-banner --ignore-gitleaks-allow --gitleaks-ignore-path=/dev/null --log-opts=HEAD^..HEAD",
    "check:response-examples": "bun scripts/response-examples.ts --check",
    "sync:response-examples": "bun scripts/response-examples.ts",
    "docs:links": "bun run --bun --no-install mint broken-links",
    "docs:validate": "bun run --bun --no-install mint validate",
    "test": "bun run --bun --no-install vitest run",
    "check:licenses": "bash scripts/licenses.sh lint",
    "check:patches": "git apply --directory=node_modules --reverse --check patches/mintlify-archives.patch",
    "check:static": "bun run --parallel --no-exit-on-error audit gitleaks check:patches check:response-examples lint lint:shell format:check docs:validate docs:links check:licenses",
    "check:all": "bun run --parallel --no-exit-on-error check:static test",
    "prepare:docs": "git apply --directory=node_modules --reverse --check patches/mintlify-archives.patch 2>/dev/null || git apply --directory=node_modules patches/mintlify-archives.patch",
    "postinstall": "bun run prepare:docs",
    "install:frozen": "bunx --bun npm@12.0.1 ci --ignore-scripts && bun run prepare:docs",
    "install:licenses": "bash scripts/licenses.sh install"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "afdocs": "0.22.2",
    "fflate": "0.8.3",
    "mint": "4.2.949",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "vitest": "5.0.2",
    "zip-a-folder": "7.0.0"
  },
  "overrides": {
    "@puppeteer/browsers": "3.2.1",
    "adm-zip": "npm:@xhmikosr/decompress@11.1.4",
    "axios": "1.20.0",
    "brace-expansion": "5.0.12",
    "fast-uri": "3.1.8",
    "front-matter": {
      "js-yaml": "3.15.2"
    },
    "ip-address": "10.7.2",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "puppeteer": "25.8.0",
    "puppeteer-core": "25.8.0",
    "qs": "6.16.0",
    "sharp": "0.35.4",
    "tar": "7.5.21"
  },
  "config": {
    "cargoAudit": "0.22.2",
    "comply": {
      "version": "0.1.1",
      "sha256": "83dc4f918dc49fc4a66b2f5ec15c2b53e1ba0d44fb3ac1f922bf2b156f7d70db",
      "sourceDateEpoch": 1785866486
    },
    "rustVersion": "1.98.1"
  },
  "packageManager": "npm@12.0.1+sha512.2f94fd8bf600416416a934bfc59c4991e8bff7372ef7d842784e2a8b8d48c81555ee645069ddea73625fb8e92dc261feab0188fd5dab6c22fefd46316f5f9140"
}
