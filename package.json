{
  "name": "xquik-docs",
  "private": true,
  "scripts": {
    "format": "bun run --bun --no-install oxfmt --write",
    "format:check": "bun run --bun --no-install oxfmt --check .",
    "lint": "bun run --bun --no-install oxlint --type-aware --type-check --deny-warnings --report-unused-disable-directives-severity=error .",
    "lint:packages": "bunx syncpack@15.3.3 lint",
    "lint:types": "type-coverage -p tsconfig.json --strict --at-least 100 && eslint --config eslint.config.mts --flag unstable_native_nodejs_ts_config --max-warnings 0 .",
    "lint:shell": "shellcheck --check-sourced --severity=style --extended-analysis=true scripts/licenses.sh",
    "audit": "osv-scanner scan source --licenses=0BSD,Apache-2.0,BlueOak-1.0.0,BSD-2-Clause,BSD-3-Clause,CC-BY-4.0,ISC,LGPL-3.0-or-later,MIT,MIT-0,MPL-2.0,Unlicense,Zlib -L package-lock.json",
    "gitleaks": "gitleaks git --config=.gitleaks.toml --redact=100 --no-banner --ignore-gitleaks-allow --gitleaks-ignore-path=/dev/null --log-opts=HEAD^..HEAD",
    "check:response-examples": "bun scripts/response-examples.ts --check",
    "sync": "bun scripts/sync-openapi.ts && bun scripts/sync-features.ts && bun scripts/response-examples.ts",
    "docs:links": "bunx --bun mint@4.3.5 broken-links",
    "docs:validate": "bunx --bun mint@4.3.5 validate",
    "docs": "bun run docs:validate && bun run docs:links",
    "test": "bun run --bun --no-install vitest run --exclude agent-docs.test.ts",
    "check:live": "bun run --bun --no-install vitest run agent-docs.test.ts",
    "check:licenses": "bash scripts/licenses.sh lint",
    "check:static": "bun run --parallel --no-exit-on-error audit gitleaks check:response-examples lint lint:types lint:packages lint:shell format:check docs check:licenses",
    "check:all": "bun run --parallel --no-exit-on-error check:static test",
    "install:frozen": "bunx --bun npm@12.2.2 ci --ignore-scripts",
    "install:licenses": "bash scripts/licenses.sh install"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@typescript-eslint/type-utils": "8.72.1",
    "@typescript-eslint/utils": "8.72.1",
    "afdocs": "0.23.0",
    "eslint": "10.14.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "type-coverage": "2.31.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "minimatch": "11.0.3"
  },
  "config": {
    "cargoAudit": "0.22.2",
    "comply": {
      "version": "0.1.1",
      "sha256": "83dc4f918dc49fc4a66b2f5ec15c2b53e1ba0d44fb3ac1f922bf2b156f7d70db",
      "sourceDateEpoch": 1785866486
    },
    "rustVersion": "1.99.0"
  },
  "packageManager": "npm@12.2.2+sha512.2a09606d9c9a71fee31fe147b8d46a56e0b3422f15848d9aec9f3b231e3716c3d3b99a065a62175c6759b4150e03bf6fc0bf8825112a511573ba903b3ec41370"
}
