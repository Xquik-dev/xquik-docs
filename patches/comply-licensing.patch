diff --git a/src/utc.rs b/src/utc.rs
new file mode 100644
index 0000000..62bf61d
--- /dev/null
+++ b/src/utc.rs
@@ -0,0 +1,130 @@
+// SPDX-FileCopyrightText: COMPLY contributors
+//
+// SPDX-License-Identifier: MIT OR Apache-2.0
+
+//! UTC calendar fields from Unix seconds, so comply needs no date crate.
+
+use std::time::{SystemTime, UNIX_EPOCH};
+
+const SECONDS_PER_DAY: i64 = 86_400;
+const SECONDS_PER_HOUR: i64 = 3_600;
+const SECONDS_PER_MINUTE: i64 = 60;
+const DAYS_PER_ERA: i64 = 146_097;
+const DAYS_FROM_YEAR_ZERO_MARCH: i64 = 719_468;
+
+/// A UTC instant split into proleptic Gregorian calendar fields.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct UtcTime {
+    /// The year, such as 2026.
+    pub year: i64,
+    /// The month, from 1 to 12.
+    pub month: i64,
+    /// The day of the month, from 1 to 31.
+    pub day: i64,
+    /// The hour, from 0 to 23.
+    pub hour: i64,
+    /// The minute, from 0 to 59.
+    pub minute: i64,
+    /// The second, from 0 to 59.
+    pub second: i64,
+}
+
+impl UtcTime {
+    /// The current time. A clock set before 1970 reads as the Unix epoch.
+    #[must_use]
+    pub fn now() -> Self {
+        let seconds = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .map_or(0, |elapsed| {
+                i64::try_from(elapsed.as_secs()).unwrap_or(i64::MAX)
+            });
+        Self::from_unix(seconds)
+    }
+
+    /// Splits Unix seconds into UTC fields with Howard Hinnant's
+    /// `civil_from_days`, which holds across the proleptic Gregorian calendar.
+    #[must_use]
+    pub fn from_unix(seconds: i64) -> Self {
+        let days = seconds.div_euclid(SECONDS_PER_DAY);
+        let of_day = seconds.rem_euclid(SECONDS_PER_DAY);
+        let shifted = days.saturating_add(DAYS_FROM_YEAR_ZERO_MARCH);
+        let era = shifted.div_euclid(DAYS_PER_ERA);
+        let day_of_era = shifted.rem_euclid(DAYS_PER_ERA);
+        let year_of_era =
+            (day_of_era - day_of_era / 1_460 + day_of_era / 36_524 - day_of_era / 146_096) / 365;
+        let day_of_year = day_of_era - (365 * year_of_era + year_of_era / 4 - year_of_era / 100);
+        let month_index = (5 * day_of_year + 2) / 153;
+        let month = if month_index < 10 {
+            month_index + 3
+        } else {
+            month_index - 9
+        };
+        Self {
+            year: year_of_era + era * 400 + i64::from(month <= 2),
+            month,
+            day: day_of_year - (153 * month_index + 2) / 5 + 1,
+            hour: of_day / SECONDS_PER_HOUR,
+            minute: of_day % SECONDS_PER_HOUR / SECONDS_PER_MINUTE,
+            second: of_day % SECONDS_PER_MINUTE,
+        }
+    }
+
+    /// `YYYY-MM-DDThh:mm:ssZ`, the only form SPDX accepts for `created`.
+    #[must_use]
+    pub fn spdx(self) -> String {
+        format!(
+            "{:04}-{:02}-{:02}T{:02}:{:02}:{:02}Z",
+            self.year, self.month, self.day, self.hour, self.minute, self.second
+        )
+    }
+
+    /// `YYYY-MM-DD hh:mm:ss UTC`, the build provenance stamp.
+    #[must_use]
+    pub fn stamp(self) -> String {
+        format!(
+            "{:04}-{:02}-{:02} {:02}:{:02}:{:02} UTC",
+            self.year, self.month, self.day, self.hour, self.minute, self.second
+        )
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::UtcTime;
+
+    #[test]
+    fn splits_known_instants() {
+        for (seconds, spdx) in [
+            (0, "1970-01-01T00:00:00Z"),
+            (951_782_400, "2000-02-29T00:00:00Z"),
+            (951_868_799, "2000-02-29T23:59:59Z"),
+            (1_709_164_800, "2024-02-29T00:00:00Z"),
+            (1_785_866_486, "2026-08-04T18:01:26Z"),
+            (4_102_444_800, "2100-01-01T00:00:00Z"),
+            (-1, "1969-12-31T23:59:59Z"),
+            (-62_135_596_800, "0001-01-01T00:00:00Z"),
+        ] {
+            assert_eq!(UtcTime::from_unix(seconds).spdx(), spdx, "{seconds}");
+        }
+    }
+
+    #[test]
+    fn stamps_the_build_form() {
+        assert_eq!(UtcTime::from_unix(1_785_866_486).stamp(), "2026-08-04 18:01:26 UTC");
+    }
+
+    #[test]
+    fn walks_every_day_of_four_centuries_in_order() {
+        let mut previous = UtcTime::from_unix(-SECONDS_PER_DAY_TEST);
+        for day in 0..146_097_i64 {
+            let next = UtcTime::from_unix(day * SECONDS_PER_DAY_TEST);
+            let advanced = (next.year, next.month, next.day) > (previous.year, previous.month, previous.day);
+            assert!(advanced, "day {day} did not advance from {previous:?} to {next:?}");
+            let rolled_month = next.day == 1;
+            assert!(rolled_month || next.day == previous.day + 1, "day {day} skipped a date");
+            previous = next;
+        }
+    }
+
+    const SECONDS_PER_DAY_TEST: i64 = 86_400;
+}
